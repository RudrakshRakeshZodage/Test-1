# Agentic Dating - Environment Configuration

# OpenAI API (Optional - application runs full autonomous dating & extraction offline/heuristically if omitted)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Default: local SQLite database)
DATABASE_URL=sqlite:///./agentic_dating.db

# Supabase PostgreSQL (For production cloud deployment)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
